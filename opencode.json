{
  "$schema": "https://opencode.ai/config.json",
  "commands": {
    "new": {
      "description": "تصفير الجلسة وبدء شات جديد نظيف على المتصفح",
      "template": "جديد"
    },
    "reset": {
      "description": "تصفير الجلسة وبدء شات جديد نظيف على المتصفح",
      "template": "reset"
    }
  },
  "model": "upstage-studio/auto",
  "provider": {
    "upstage-studio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Upstage Studio (Free Frontier Gateway)",
      "options": {
        "baseURL": "http://127.0.0.1:8002/v1",
        "apiKey": "upstage-studio-free"
      },
      "models": {
        "auto": {
          "name": "⚡ Upstage Auto (الوضع التلقائي الذكي الشامل)"
        },
        "gpt-5.4": {
          "name": "🧠 GPT-5.4 (Frontier Thinking)"
        },
        "claude-sonnet-5-5": {
          "name": "🎭 Claude Sonnet 5.5 (Tool-Calling Agent)"
        },
        "gemini-3.1-pro-preview": {
          "name": "🌐 Gemini 3.1 Pro Preview"
        },
        "solar-pro4": {
          "name": "☀️ Solar Pro 4"
        },
        "grok-4.7": {
          "name": "🚀 Grok 4.7"
        }
      }
    },
    "upstage": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Upstage Solar API (Official)",
      "options": {
        "baseURL": "https://api.upstage.ai/v1/solar",
        "apiKey": "${UPSTAGE_API_KEY}"
      },
      "models": {
        "solar-pro4": {
          "name": "Solar Pro 4 (Primary)"
        },
        "solar-mini4": {
          "name": "Solar Mini 4"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": [
          "browse.exe",
          "mcp"
        ],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  }
}
