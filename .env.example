# ════════════════════════════════════════════════════════════════════════════════
# 🌐 OpenCode Upstage Bridge Configuration
# ════════════════════════════════════════════════════════════════════════════════

# Upstage Studio Session (Cookie & Organization ID)
# استخرجها من المتصفح (F12 -> Application -> Cookies -> studio.upstage.ai)
UPSTAGE_SESSION_COOKIE=your_session_cookie_here
UPSTAGE_ORG_ID=your_org_id_here

# Permission Mode:
# bypass = ⚡ Skip permissions (الوضع السريع المباشر لتنفيذ الأدوات بدون مقاطعة)
# auto   = ✨ Auto (الوضع الذكي يسأل فقط عند الحاجة)
# manual = 🛡️ Ask for permission (يسأل قبل كل خطوة)
UPSTAGE_PERMISSION_MODE=bypass

# Optional Official Upstage Solar API Key
UPSTAGE_API_KEY=your_official_upstage_solar_api_key_here
